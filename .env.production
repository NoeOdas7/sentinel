# SENTINEL - Configuration production Brevo
# Copier dans .env et remplir les valeurs reelles

SECRET_KEY=REMPLACER_PAR_UNE_CLE_ALEATOIRE_50_CHARS_MIN
DEBUG=False
USE_REMOTE_DB=True
DEMO_ADMIN_EMAIL=admin@odas.org
DEMO_ADMIN_PASSWORD=changez-ce-mot-de-passe
DEMO_ADMIN_NAME=Admin Demo ODAS

ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app,.up.railway.app,votre-app.up.railway.app

# Base de donnees
DATABASE_URL=postgresql://postgres:VOTRE_MOT_DE_PASSE@db.VOTRE_ID.supabase.co:5432/postgres?sslmode=require

# Email SMTP reel via Brevo
# 1. Creer/verifier votre domaine dans Brevo
# 2. Authentifier ce domaine avec les enregistrements DNS demandes par Brevo
# 3. Creer un sender valide du type no-reply@votre-domaine.org
# 4. Recuperer le SMTP login et la SMTP key dans Brevo
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20
EMAIL_HOST_USER=votre-login-smtp-brevo
EMAIL_HOST_PASSWORD=votre-smtp-key-brevo
DEFAULT_FROM_EMAIL=SENTINEL ODAS <no-reply@votre-domaine.org>
EMAIL_DEMO_FALLBACK=False

FRONTEND_URL=https://votre-app.up.railway.app
CORS_ALLOWED_ORIGINS=https://votre-app.up.railway.app

OTP_EXPIRY_SECONDS=600
FIRST_LOGIN_CODE_EXPIRY_HOURS=72
